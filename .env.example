# ─── Base de données ──────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled)
# Obtenir depuis : https://console.neon.tech → votre projet → Connection string
DATABASE_URL=

# ─── Authentification ─────────────────────────────────────────────────────────
# Clé secrète Better Auth — minimum 32 caractères, générer avec :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL de base de l'app (doit correspondre à NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CI / Build uniquement ────────────────────────────────────────────────────
# Mettre à "true" uniquement en CI sans secrets configurés.
# Ne jamais utiliser en production.
# SKIP_ENV_VALIDATION=true
