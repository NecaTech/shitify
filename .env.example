# ─── Base de données ──────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (pooled)
# Obtenir depuis : https://console.neon.tech → votre projet → Connection string
DATABASE_URL=

# Environnement applicatif isolé. Valeurs autorisées : dev, staging, prod.
APP_ENV=dev

# Slugs PostgreSQL pour le schema DB : {CLIENT_SLUG}_{PROJECT_SLUG}_{APP_ENV}
# Minuscules, chiffres et underscores uniquement.
CLIENT_SLUG=client
PROJECT_SLUG=project

# ─── Authentification ─────────────────────────────────────────────────────────
# Clé secrète Better Auth — minimum 32 caractères, générer avec :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL de base de l'app (doit correspondre à NEXT_PUBLIC_APP_URL)
# Sur Vercel, peut être omise si les variables système Vercel sont exposées.
BETTER_AUTH_URL=http://localhost:3000

# ─── App ──────────────────────────────────────────────────────────────────────
# Sur Vercel, peut être omise si les variables système Vercel sont exposées.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CI / Build uniquement ────────────────────────────────────────────────────
# Mettre à "true" uniquement pour les vérifications locales/non-production.
# Inefficace sur un build Vercel production.
# SKIP_ENV_VALIDATION=true
