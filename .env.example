# ─── Base de données ──────────────────────────────────────────────────────────
# Phase dev : laisser vide, LOCAL_AUTH_ENABLED ouvre le dashboard sans DB.
# Invariants pré-clonage avec DB locale :
#   pnpm db:local:env && pnpm db:local:up && pnpm db:push && pnpm db:seed
#   postgres://necatech:necatech_local_password@localhost:54329/necatech_boilerplate
# Phase staging/production : Neon PostgreSQL connection string (pooled).
# Obtenir depuis : https://console.neon.tech → votre projet → Connection string
DATABASE_URL=

# Environnement applicatif isolé. Valeurs autorisées : dev, staging, prod.
# dev = local sans DB obligatoire ; staging/prod = DB réelle configurée.
APP_ENV=dev

# Slugs PostgreSQL pour le schema DB : {CLIENT_SLUG}_{PROJECT_SLUG}_{APP_ENV}
# Minuscules, chiffres et underscores uniquement.
CLIENT_SLUG=client
PROJECT_SLUG=project

# ─── Authentification ─────────────────────────────────────────────────────────
# Clé secrète Better Auth — minimum 32 caractères, générer avec :
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL de base de l'app (doit correspondre à NEXT_PUBLIC_APP_URL)
# Sur Vercel, peut être omise si les variables système Vercel sont exposées.
BETTER_AUTH_URL=http://localhost:3000

# ─── Founder local / seed DB ──────────────────────────────────────────────────
# Phase dev : identifiants de connexion locale au dashboard.
# Phase staging/prod : valeurs utilisées par `pnpm db:seed`.
# Ne pas committer de vrai mot de passe client.
FOUNDER_EMAIL=
FOUNDER_NAME=
FOUNDER_INITIAL_PASSWORD=

# Phase dev : true pour ouvrir le dashboard sans DB client.
# Phase staging/prod : false. Désactivé automatiquement en production.
LOCAL_AUTH_ENABLED=true

# Mettre à "true" uniquement pour remplacer le mot de passe d'un founder existant.
# FOUNDER_RESET_PASSWORD=true

# Workspace initial créé par le seed. Valeurs non sensibles.
# Par défaut : nom dérivé de PROJECT_SLUG, slug dérivé de PROJECT_SLUG.
# INITIAL_WORKSPACE_NAME=
# INITIAL_WORKSPACE_SLUG=

# ─── App ──────────────────────────────────────────────────────────────────────
# Sur Vercel, peut être omise si les variables système Vercel sont exposées.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── CI / Build uniquement ────────────────────────────────────────────────────
# Mettre à "true" uniquement pour les vérifications locales/non-production.
# Inefficace sur un build Vercel production.
# SKIP_ENV_VALIDATION=true
